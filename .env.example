# --- Required ---
# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: payments (Paystack) ---
# Without this, payments run in demo mode (no real gateway calls).
PAYSTACK_SECRET_KEY=

# --- Optional: transactional email (Brevo SMTP) ---
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=

# --- Optional: SMS (Termii) ---
TERMII_API_KEY=
TERMII_SENDER_ID=

# --- Optional: web push notifications ---
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Optional: AI-assisted match explanations ---
GROQ_API_KEY=

# --- Optional: protects the weekly report cron endpoint ---
CRON_SECRET=
